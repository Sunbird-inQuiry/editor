# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real tokens.
#
# Used by BOTH:
#   npm run dev   (Vite dev server — mock mode when BASE_URL is unset)
#   npm run serve (standalone server.js — always needs BASE_URL)

# --- QuestionSet to load ---
CONTENT_ID=do_XXXXXXXXXXXXXXXXXXXX

# --- Real Sunbird backend (e.g. dev.sunbirded.org or test.sunbirded.org) ---
BASE_URL=https://test.sunbirded.org
AUTH_TOKEN=your_api_auth_token_here
USER_TOKEN=your_user_token_here

# --- Optional context overrides ---
CHANNEL=0144880972895272960
FRAMEWORK=NCF
MODE=edit
USER_ID=your_real_user_uuid_here

# --- Standalone server port (npm run serve) ---
# Default: 9001  (avoids clash with portal on 3000)
# PORT=9001
