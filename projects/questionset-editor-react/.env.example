# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real tokens.
#
# When BASE_URL is set, the dev server proxies all API calls to the real
# Sunbird backend with your auth headers — exactly like the old server.js.
# When it is NOT set, mock data is used and no backend is needed.

# --- QuestionSet to load ---
CONTENT_ID=do_XXXXXXXXXXXXXXXXXXXX

# --- Real Sunbird backend (e.g. dev.sunbirded.org or test.sunbirded.org) ---
BASE_URL=https://dev.sunbirded.org
AUTH_TOKEN=your_api_auth_token_here
USER_TOKEN=your_user_token_here

# --- Optional context overrides ---
CHANNEL=0144880972895272960
FRAMEWORK=NCF
MODE=edit
